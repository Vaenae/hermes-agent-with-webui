# Copy to `.env` and fill in. Compose reads it automatically.

# Pin this to a release or sha-* tag for reproducible deployments.
HERMES_WEBUI_IMAGE=ghcr.io/vaenae/hermes-webui:latest

# SearXNG server secret. The image's entrypoint rewrites `server.secret_key`
# from this variable, so the value in searxng/settings.yml is never used.
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
